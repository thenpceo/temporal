# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=support-ops-demo
TEMPORAL_UI_BASE_URL=http://localhost:8233

# Pylon, optional
PYLON_API_KEY=
PYLON_API_BASE_URL=

# Salesforce, optional
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_INSTANCE_URL=

# Slack, optional but recommended
SLACK_WEBHOOK_URL=

# BigQuery, optional
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=support_ops_demo
BIGQUERY_TABLE=events

# Anthropic — set this to enable real LLM classification, drafting, agentic investigation, and playbook clustering
# When unset, all LLM-powered activities fall back to deterministic mocks
ANTHROPIC_API_KEY=

# Demo
USE_MOCKS=true
